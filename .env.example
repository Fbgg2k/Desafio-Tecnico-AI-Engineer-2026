# Provedor: gemini (padrão), groq ou ollama (local, sem chave de API)
LLM_PROVIDER=gemini

# Google AI Studio / Gemini (necessário somente com LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your-key-here

# GroqCloud (necessário somente com LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Ollama (necessário somente com LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
