# Copie este arquivo para .env e configure um provedor.
# Use LLM_PROVIDER=gemini OU LLM_PROVIDER=groq.
LLM_PROVIDER=groq

# Google AI Studio / Gemini:
# Se escolher Gemini, troque LLM_PROVIDER para gemini e informe sua chave.
# GOOGLE_API_KEY=cole-sua-chave-google-aqui
# GEMINI_MODEL=gemini-2.5-flash

# GroqCloud:
# Preencha sua chave pessoal criada em https://console.groq.com/keys
GROQ_API_KEY=cole-sua-chave-groq-aqui
GROQ_MODEL=openai/gpt-oss-20b
